# PEAK3 Arena — API environment variables
# Copy to .env and fill in values (never commit .env)

# ---- Core ----
PEAK3_SIGNING_SECRET=change-me-in-production
PEAK3_DEBUG=true
PEAK3_CORS_ORIGINS=["http://localhost:3000"]
PEAK3_SESSION_TTL_SECONDS=86400

# ---- Phase 3.0 — Durable persistence (required in production) ----
# PostgreSQL connection string for durable game records, profiles, history.
# When unset in DEBUG mode, falls back to in-memory storage (state lost on restart).
# Local Supabase stack (see the Phase 4.0A section below): this is DB_URL
# from `supabase status`, e.g.:
# PEAK3_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# ---- Supabase Auth — token verification (required for authenticated routes) ----
#
# There are two signing regimes. The API picks one PER TOKEN from its `alg`
# header, so a project mid-migration works with both set.
#
# 1) ASYMMETRIC / JWKS — the default for Supabase projects created after the
#    asymmetric signing-key rollout, and what this repo's hosted development
#    project uses (ES256, EC P-256). There is NO shared secret to configure:
#    set the project URL and verification works from the project's PUBLIC keys.
#    Do not go looking for a "JWT secret" for such a project — it does not have
#    one, and inventing a placeholder will not make anything verify.
PEAK3_SUPABASE_URL=https://your-project.supabase.co
#    Both of these are derived from PEAK3_SUPABASE_URL and only need setting if
#    your project serves them from somewhere non-standard:
#      JWKS   -> {PEAK3_SUPABASE_URL}/auth/v1/.well-known/jwks.json
#      issuer -> {PEAK3_SUPABASE_URL}/auth/v1
# PEAK3_SUPABASE_JWKS_URL=
# PEAK3_SUPABASE_JWT_ISSUER=
#    Expected `aud` claim; Supabase stamps "authenticated" on user tokens.
# PEAK3_SUPABASE_JWT_AUDIENCE=authenticated
#
# 2) SYMMETRIC / HS256 — LEGACY. Pre-migration hosted projects and the local
#    `supabase start` stack (this is JWT_SECRET from `supabase status`). Leave
#    unset for an asymmetric project.
# PEAK3_SUPABASE_JWT_SECRET=your-supabase-jwt-secret
#
# GET /health/readiness reports `auth_verification_mode`:
#   jwks | hs256 | jwks+hs256 | unconfigured
# `unconfigured` is a hard startup error when PEAK3_DEBUG=False — it used to be
# a single WARNING line and a silent, total auth outage.
# See docs/implementation/AUTH_CONFIGURATION.md for the full setup.

# ---- Supabase project details (exposed to the frontend separately) ----
# Anon/publishable key — public by design. NEVER put a service-role or secret
# key here or in any NEXT_PUBLIC_* variable.
# Local stack: ANON_KEY (or PUBLISHABLE_KEY) from `supabase status`.
# PEAK3_SUPABASE_ANON_KEY=your-anon-key

# ---- Phase 4.0A — Local Supabase stack (dev only; never a hosted project) ----
# Run once: `npx supabase init` (already committed under supabase/), then:
#   npx supabase start        # boots the local stack (Docker)
#   npx supabase status       # prints the values below
#   npx supabase db reset     # replays supabase/migrations/ from scratch
# `supabase status` maps directly onto the vars above and below:
#   DB_URL            -> PEAK3_DATABASE_URL / PEAK3_TEST_DATABASE_URL
#   API_URL            -> PEAK3_SUPABASE_URL / PEAK3_TEST_SUPABASE_URL
#   ANON_KEY (or PUBLISHABLE_KEY) -> PEAK3_SUPABASE_ANON_KEY / PEAK3_TEST_SUPABASE_ANON_KEY
#   SERVICE_ROLE_KEY   -> PEAK3_TEST_SUPABASE_SERVICE_ROLE_KEY (server/test-only — never bundled into the frontend)
#   JWT_SECRET         -> PEAK3_SUPABASE_JWT_SECRET / PEAK3_TEST_SUPABASE_JWT_SECRET
# The local stack's ports are shifted +100 (API 54421, DB 54422, Studio 54423,
# Mailpit 54424) so PEAK3 can run alongside another local Supabase project on
# the default 5432x block. `supabase status` always prints the live values —
# read them from there, never from this file.
#
# As of this pass the repo IS linked to a hosted *development* project and
# migrations are applied to it with `npx supabase db push`. That supersedes the
# earlier "never link to a hosted project" rule recorded in
# docs/implementation/LOCAL_DEV.md. The local stack remains the fastest path for
# the RLS/Postgres integration suite and is what CI-equivalent runs use.
# Local dev with no env set at all falls back to in-memory repositories (see
# the startup log line "Repository registry: memory (N/N domains)" — a loud,
# explicit warning, not a silent default) — set the vars above to use the
# local Postgres/Auth stack instead.

# ---- DEPLOYED ENVIRONMENTS (PEAK3_DEBUG=false) --------------------------------
#
# With DEBUG=false the API refuses to start on a configuration that is fine on a
# laptop and wrong once deployed. Each check is at startup, so the failure is a
# refused boot (a rollback) rather than a running misconfiguration (an incident).
# See Settings._assert_deployable in app/core/config.py.
#
#   * any of PEAK3_SUPABASE_URL / PEAK3_SUPABASE_JWKS_URL / PEAK3_DATABASE_URL
#     naming localhost, 127.0.0.1, 0.0.0.0, ::1 or host.docker.internal
#   * PEAK3_CORS_ORIGINS containing a localhost origin, '*', or being empty
#     ('*' matters because the API sends allow_credentials=True, so a wildcard
#     is not "any origin without cookies" — Starlette echoes the caller's
#     Origin, which is the same-origin policy switched off)
#   * PEAK3_SUPABASE_URL / PEAK3_SUPABASE_JWKS_URL over http://
#   * a missing or empty generated dataset under data/web/
#   * PEAK3_RANKED_ENABLED=true while READINESS_LEVEL is disabled/simulation_only
#   * PEAK3_SIGNING_SECRET left at the shipped default
#   * PEAK3_DATABASE_URL unset (which would mean in-memory repositories)
#   * no token verification configured at all

# ---- CONFIGURATION CONTRACT: Supabase project identity -----------------------
#
# PEAK3_SUPABASE_URL (here) and NEXT_PUBLIC_SUPABASE_URL (apps/web/.env.local)
# MUST name the same Supabase project. This is the single most likely
# production misconfiguration and it does not look like one from the outside:
# the browser holds a valid session and renders the account avatar, while every
# authenticated write returns 401. The API verifies access tokens against the
# JWKS of the project named HERE, so a token minted by any other project is
# correctly rejected as unverifiable.
#
# Symptom if they disagree: "authentication_required" on save / history /
# ranked, while visibly signed in. Since this pass the API logs the diagnosis
# explicitly at WARNING ("Token issuer=... this API verifies issuer=..."), so
# check the API log first -- it names both sides.
#
# Note that changing either URL does NOT invalidate sessions already in a
# browser: a stale cookie from the previous project keeps the user looking
# signed in. Sign out and back in after repointing.

# ---- Phase 4.0 — Ranked duels (closed alpha; disabled by default) ----
#
# CONTRACT: these are the ONLY switches for ranked. There is no frontend
# ranked flag -- apps/web reads GET /api/v1/ranked/readiness and renders
# whatever the server reports, so the server is the single source of truth and
# the two cannot disagree. "Ranked is not currently enabled." in the UI means
# exactly one thing: this API answered ranked_enabled=false.
#
# To enable ranked in an environment, all four of:
#   PEAK3_RANKED_ENABLED=true
#   PEAK3_RANKED_MATCHMAKING_ENABLED=true      # join/leave queue + pairing
#   PEAK3_RANKED_RATING_WRITES_ENABLED=true    # Glicko-2 persistence
#   PEAK3_RANKED_READINESS_LEVEL=internal_alpha  # or closed_alpha / public_beta
# plus migrations applied (ranked_queue_versions must be seeded -- the API
# seeds it at startup; see app/main.py).
#
# Leaving READINESS_LEVEL=disabled while the booleans are true is a valid,
# deliberate state (kill switch) and the UI will report ranked as unavailable.
# Independent capability switches — do not use one flag for everything.
PEAK3_RANKED_ENABLED=false
PEAK3_RANKED_MATCHMAKING_ENABLED=false
PEAK3_RANKED_RATING_WRITES_ENABLED=false
PEAK3_RANKED_PUBLIC_LEADERBOARD_ENABLED=false
PEAK3_RANKED_ALPHA_ALLOWLIST=[]
# One of: disabled | simulation_only | internal_alpha | closed_alpha | public_beta
PEAK3_RANKED_READINESS_LEVEL=disabled

# ---- Phase 4.0/4.0A — Supabase integration-test mode ----
# Used by apps/api/tests/integration/ (pytest -m supabase_integration) and by
# tests/test_repository_conformance.py's PostgreSQL half. When unset, those
# tests report "not configured" / skip explicitly — never silently reported
# as passing. As of Phase 4.0A these CAN be pointed at the local Supabase
# stack above (same values as PEAK3_DATABASE_URL/PEAK3_SUPABASE_URL etc,
# just under the TEST_ prefix so a real hosted test project can be swapped in
# later without code changes) — this is still local-only, never a hosted
# project, per this phase's explicit constraints.
# PEAK3_TEST_SUPABASE_URL=http://127.0.0.1:54421
# PEAK3_TEST_SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key
# PEAK3_TEST_SUPABASE_ANON_KEY=your-test-anon-key
# PEAK3_TEST_SUPABASE_JWT_SECRET=your-test-jwt-secret
# PEAK3_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# ---- Postgres-mode functional suite (apps/api/tests/conftest.py, a DIFFERENT
# switch from the integration-test mode above) ----
# PEAK3_TEST_REPOSITORY_MODE=postgres runs the app's own TestClient-based
# functional suite (all of tests/, including tests/test_perfect_season.py's
# game-creation/completion/leaderboard-submit flows) against a real backend
# instead of in-memory repositories. This performs REAL writes — games,
# leaderboard rows, profiles — so it requires TWO independent, explicit
# opt-ins, deliberately never satisfiable by accident:
#   1. PEAK3_TEST_DATABASE_URL, an isolated test project — never
#      PEAK3_DATABASE_URL, which this test process refuses to read at all
#      (that name is what the deployed staging/production API reads; see
#      docs/implementation/launch-polish/IDENTITY_AUDIT.md §1.3 for the
#      contamination this caused when the two were conflated).
#   2. PEAK3_ALLOW_DESTRUCTIVE_DB_TESTS=1, a second acknowledgement that this
#      run writes real rows, not just happens to have a Postgres URL handy.
# Missing either one is a loud RuntimeError at collection time, not a skip.
# PEAK3_TEST_REPOSITORY_MODE=postgres
# PEAK3_ALLOW_DESTRUCTIVE_DB_TESTS=1
